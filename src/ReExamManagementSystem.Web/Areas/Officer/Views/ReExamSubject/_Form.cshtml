@using Microsoft.AspNetCore.Mvc.Rendering
@model ReExamSubjectFormViewModel
@{
    var isEdit = Model.Id != 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit Re-Exam Subject" : "Open Course for Re-Exam")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="CourseId" class="form-label"></label>
            <select asp-for="CourseId" class="form-select" asp-items="@(new SelectList(Model.CourseOptions, "Id", "Name"))">
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="AcademicYearId" class="form-label"></label>
                <select asp-for="AcademicYearId" class="form-select" asp-items="@(new SelectList(Model.AcademicYearOptions, "Id", "Name"))">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="AcademicYearId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="SemesterId" class="form-label"></label>
                <select asp-for="SemesterId" class="form-select" asp-items="@(new SelectList(Model.SemesterOptions, "Id", "Name"))">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="SemesterId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Open for applications</label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
