@using ReExamManagementSystem.Application.Common
@model PagedResult<EligibleStudentViewModel>
@{
    ViewData["Title"] = "Eligible Students";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-clipboard-check"></i> Eligible Students</h4>
    <form asp-action="Recompute" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-arrow-repeat"></i> Recompute Eligibility
        </button>
    </form>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by student name, number or course..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Previous Mark</th>
                    <th>Grade</th>
                    <th>Term</th>
                    <th>Reason</th>
                    <th>Application</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No eligible students found.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.StudentName <div class="text-muted small">@item.StudentNumber</div></td>
                        <td><span class="badge text-bg-secondary">@item.CourseCode</span> @item.CourseName</td>
                        <td>@item.PreviousMark</td>
                        <td>@item.PreviousGrade</td>
                        <td>@item.AcademicYearName - @item.SemesterName</td>
                        <td class="small text-muted">@item.Reason</td>
                        <td>
                            @if (item.HasActiveApplication)
                            {
                                <span class="badge text-bg-info">Applied</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Not applied</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
