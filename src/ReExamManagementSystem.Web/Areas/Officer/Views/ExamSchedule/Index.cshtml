@using ReExamManagementSystem.Application.Common
@model PagedResult<ExamScheduleListItemViewModel>
@{
    ViewData["Title"] = "Examination Schedule";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-calendar-event"></i> Examination Schedule</h4>
    <button type="button" class="btn btn-primary" data-crud-url="@Url.Action("Create")">
        <i class="bi bi-plus-lg"></i> Schedule Exam
    </button>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by course code or name..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Room</th>
                    <th>Invigilator</th>
                    <th>Registered / Capacity</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No exams scheduled yet.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><span class="badge text-bg-secondary">@item.CourseCode</span> @item.CourseName</td>
                        <td>@item.ExamDate.ToString("dd MMM yyyy")</td>
                        <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                        <td>@item.RoomLabel</td>
                        <td>@item.InvigilatorName</td>
                        <td>
                            @item.RegisteredStudentCount / @item.RoomCapacity
                            @if (item.RegisteredStudentCount > item.RoomCapacity)
                            {
                                <i class="bi bi-exclamation-triangle-fill text-danger" title="Over capacity"></i>
                            }
                        </td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    ExamStatus.Scheduled => "text-bg-primary",
                                    ExamStatus.Ongoing => "text-bg-warning",
                                    ExamStatus.Completed => "text-bg-success",
                                    _ => "text-bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="ExamAttendance" asp-action="Index" asp-route-scheduleId="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-clipboard-check"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-crud-url="@Url.Action("Edit", new { id = item.Id })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-delete-name="@item.CourseCode">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
