@using ReExamManagementSystem.Application.Common
@model PagedResult<ResultListItemViewModel>
@{
    ViewData["Title"] = "Verify & Publish Results";
    var search = ViewData["Search"] as string;
    var verified = ViewData["Verified"] as bool?;
    var published = ViewData["Published"] as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-award"></i> Verify &amp; Publish Results</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Enter Marks</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by student or course..." />
            </div>
            <div class="col-auto" style="min-width:170px;">
                <select name="verified" class="form-select" onchange="this.form.submit()">
                    <option value="">All (Verified)</option>
                    <option value="false" selected="@(verified == false ? "selected" : null)">Not Verified</option>
                    <option value="true" selected="@(verified == true ? "selected" : null)">Verified</option>
                </select>
            </div>
            <div class="col-auto" style="min-width:170px;">
                <select name="published" class="form-select" onchange="this.form.submit()">
                    <option value="">All (Published)</option>
                    <option value="false" selected="@(published == false ? "selected" : null)">Not Published</option>
                    <option value="true" selected="@(published == true ? "selected" : null)">Published</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Original</th>
                    <th>Re-Exam</th>
                    <th>Final</th>
                    <th>Grade</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No results found.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.StudentName <div class="text-muted small">@item.StudentNumber</div></td>
                        <td><span class="badge text-bg-secondary">@item.CourseCode</span></td>
                        <td>@item.OriginalMark</td>
                        <td>@item.ReExamMark</td>
                        <td>@item.FinalMark</td>
                        <td>@item.Grade</td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge text-bg-success">Published</span>
                            }
                            else if (item.IsVerified)
                            {
                                <span class="badge text-bg-info">Verified</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pending</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Review
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Review", new { search, verified, published, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
