@using ReExamManagementSystem.Application.Common
@model PagedResult<PendingResultEntryViewModel>
@{
    ViewData["Title"] = "Enter Re-Exam Marks";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Enter Re-Exam Marks</h4>
    <a asp-action="Review" class="btn btn-outline-secondary">Verify &amp; Publish Results</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by student or course..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Original Mark</th>
                    <th>Original Grade</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No results are pending entry.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.StudentName <div class="text-muted small">@item.StudentNumber</div></td>
                        <td><span class="badge text-bg-secondary">@item.CourseCode</span> @item.CourseName</td>
                        <td>@item.OriginalMark</td>
                        <td>@item.OriginalGrade</td>
                        <td class="text-end">
                            <a asp-action="Enter" asp-route-applicationId="@item.ApplicationId" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil"></i> Enter Mark
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
