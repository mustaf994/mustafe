@using ReExamManagementSystem.Application.Common
@model PagedResult<ApplicationListItemViewModel>
@{
    ViewData["Title"] = "Re-Exam Applications";
    var status = ViewData["Status"] as ApplicationStatus?;
    var search = ViewData["Search"] as string;
}

<h4 class="mb-4"><i class="bi bi-file-earmark-text"></i> Re-Exam Applications</h4>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by student or course..." />
            </div>
            <div class="col-auto" style="min-width:200px;">
                <select name="status" class="form-select" onchange="this.form.submit()" asp-items="Html.GetEnumSelectList<ApplicationStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Applied On</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No applications found.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.StudentName <div class="text-muted small">@item.StudentNumber</div></td>
                        <td><span class="badge badge-soft-secondary">@item.CourseCode</span> @item.CourseName</td>
                        <td>@item.ApplicationDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    ApplicationStatus.Pending => "badge-soft-warning",
                                    ApplicationStatus.Approved => "badge-soft-success",
                                    ApplicationStatus.Rejected => "badge-soft-danger",
                                    ApplicationStatus.Cancelled => "badge-soft-secondary",
                                    _ => "badge-soft-info"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Review" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Review
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, status, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
