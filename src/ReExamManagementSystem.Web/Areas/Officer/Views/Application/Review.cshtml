@model ApplicationDetailsViewModel
@{
    ViewData["Title"] = "Review Application";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Review Application</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">Student</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.StudentName (@Model.StudentNumber)</dd>
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.StudentEmail</dd>
                    <dt class="col-sm-3">Department / Program</dt>
                    <dd class="col-sm-9">@Model.DepartmentName / @Model.ProgramName</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">Course &amp; Eligibility</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Course</dt>
                    <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.CourseCode</span> @Model.CourseName</dd>
                    <dt class="col-sm-3">Previous Result</dt>
                    <dd class="col-sm-9">@Model.PreviousMark (@Model.PreviousGrade)</dd>
                    <dt class="col-sm-3">Eligibility Reason</dt>
                    <dd class="col-sm-9">@Model.EligibilityReason</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">Application</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Applied On</dt>
                    <dd class="col-sm-9">@Model.ApplicationDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-3">Academic Year / Semester</dt>
                    <dd class="col-sm-9">@Model.AcademicYearName / @Model.SemesterName</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@Model.Status</dd>
                    @if (Model.RejectionReason is not null)
                    {
                        <dt class="col-sm-3">Rejection Reason</dt>
                        <dd class="col-sm-9">@Model.RejectionReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">Decision</div>
            <div class="card-body d-grid gap-2">
                @if (Model.Status == ReExamManagementSystem.Domain.Enums.ApplicationStatus.Pending)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Approve
                        </button>
                    </form>
                    <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="bi bi-x-circle"></i> Reject
                    </button>
                }
                else
                {
                    <p class="text-muted mb-0">This application has already been reviewed.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Reject Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason for rejection</label>
                    <textarea name="rejectionReason" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject Application</button>
                </div>
            </form>
        </div>
    </div>
</div>
