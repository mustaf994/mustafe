@using System.Text.Json
@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";

    var cards = new[]
    {
        ("Eligible Subjects", Model.EligibleSubjects, "bi-clipboard-check", "bg-soft-yellow", Url.Action("Eligible", "Application")),
        ("Applications", Model.TotalApplications, "bi-file-earmark-text", "bg-soft-blue", Url.Action("Index", "Application")),
        ("Approved", Model.ApprovedApplications, "bi-check-circle", "bg-soft-green", Url.Action("Index", "Application")),
        ("Pending", Model.PendingApplications, "bi-hourglass-split", "bg-soft-orange", Url.Action("Index", "Application")),
        ("Upcoming Exams", Model.UpcomingExamsCount, "bi-calendar-event", "bg-soft-purple", Url.Action("Index", "ExamSchedule")),
    };
}

<div class="mb-4">
    <h4 class="mb-0">Student Dashboard</h4>
    <p class="text-muted mb-0">Welcome, @User.Identity?.Name</p>
</div>

<div class="row g-3 mb-4">
    @foreach (var (title, value, icon, colorClass, url) in cards)
    {
        <div class="col-6 col-md-4 col-xl">
            <a href="@url" class="card stat-card stat-card-link h-100 text-decoration-none text-reset">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon @colorClass me-3">
                        <i class="bi @icon"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@value</div>
                        <div class="text-muted small">@title</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                My Academic Results
                <a asp-controller="Result" asp-action="Index" class="small">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Course</th><th>Mark</th><th>Grade</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentResults.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No published results yet.</td></tr>
                        }
                        @foreach (var result in Model.RecentResults)
                        {
                            var resultBadge = result.Status == ResultStatus.Pass ? "badge-soft-success" : "badge-soft-danger";
                            <tr>
                                <td><span class="badge badge-soft-secondary">@result.CourseCode</span></td>
                                <td>@result.FinalMark</td>
                                <td>@result.Grade</td>
                                <td><span class="badge @resultBadge">@result.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                Upcoming Examinations
                <a asp-controller="ExamSchedule" asp-action="Index" class="small">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Course</th><th>Date</th><th>Time</th><th>Room</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.UpcomingExams.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No exams scheduled yet.</td></tr>
                        }
                        @foreach (var exam in Model.UpcomingExams)
                        {
                            <tr>
                                <td><span class="badge badge-soft-secondary">@exam.CourseCode</span></td>
                                <td>@exam.ExamDate.ToString("dd MMM yyyy")</td>
                                <td>@exam.StartTime.ToString(@"hh\:mm")</td>
                                <td>@exam.RoomLabel</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                Recent Notifications
                <a asp-area="" asp-controller="Notification" asp-action="Index" class="small">View all</a>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.RecentNotifications.Count == 0)
                {
                    <div class="text-center text-muted py-4">No notifications yet.</div>
                }
                @foreach (var notification in Model.RecentNotifications)
                {
                    <div class="list-group-item @(notification.IsRead ? "" : "bg-light")">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold small">@notification.Title</span>
                            <span class="text-muted small">@notification.CreatedAt.ToString("dd MMM")</span>
                        </div>
                        <div class="small text-muted">@notification.Message</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">Application Status</div>
            <div class="card-body"><canvas id="appStatusChart"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script>
        const appStatus = @Html.Raw(JsonSerializer.Serialize(Model.ApplicationsByStatus));
        new Chart(document.getElementById('appStatusChart'), {
            type: 'doughnut',
            data: {
                labels: appStatus.length ? appStatus.map(p => p.Label) : ['No applications'],
                datasets: [{
                    data: appStatus.length ? appStatus.map(p => p.Value) : [1],
                    backgroundColor: appStatus.length ? ['#ffc107', '#198754', '#dc3545', '#6c757d', '#0dcaf0'] : ['#e9ecf3']
                }]
            },
            options: { responsive: true }
        });
    </script>
}
