@model IReadOnlyList<SystemSettingFormViewModel>
@{
    ViewData["Title"] = "System Settings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-gear"></i> System Settings</h4>
    <button type="button" class="btn btn-primary" data-crud-url="@Url.Action("Create")">
        <i class="bi bi-plus-lg"></i> Add Setting
    </button>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Key</th>
                    <th>Value</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No system settings configured yet.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.Key</code></td>
                        <td>@item.Value</td>
                        <td class="small text-muted">@item.Description</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-crud-url="@Url.Action("Edit", new { id = item.Id })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-delete-name="@item.Key">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
