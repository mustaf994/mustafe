@using ReExamManagementSystem.Application.Common
@using ReExamManagementSystem.Domain.Enums
@model PagedResult<ExamRoomListItemViewModel>
@{
    ViewData["Title"] = "Examination Rooms";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-door-open"></i> Examination Rooms</h4>
    <button type="button" class="btn btn-primary" data-crud-url="@Url.Action("Create")">
        <i class="bi bi-plus-lg"></i> Add Room
    </button>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by room number or building..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Room</th>
                    <th>Building</th>
                    <th>Capacity</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No exam rooms found.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.RoomNumber</td>
                        <td>@item.Building</td>
                        <td>@item.Capacity</td>
                        <td>@(item.Location ?? "-")</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    RoomStatus.Available => "text-bg-success",
                                    RoomStatus.UnderMaintenance => "text-bg-warning",
                                    _ => "text-bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-crud-url="@Url.Action("Edit", new { id = item.Id })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-delete-name="@item.Building @item.RoomNumber">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
