@model StudentFormViewModel
@{
    ViewData["Title"] = "Add Student";
}

<h4 class="mb-4"><i class="bi bi-person-plus"></i> Add Student</h4>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <partial name="_FormFields" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Create Student</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
