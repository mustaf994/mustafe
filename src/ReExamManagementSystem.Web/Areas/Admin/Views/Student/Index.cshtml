@using ReExamManagementSystem.Application.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@using ReExamManagementSystem.Domain.Enums
@model PagedResult<StudentListItemViewModel>
@{
    ViewData["Title"] = "Student Management";
    var search = ViewData["Search"] as string;
    var departmentId = ViewData["DepartmentId"] as int?;
    var departmentOptions = ViewData["DepartmentOptions"] as List<SelectOption> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-people"></i> Student Management</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Student</a>
</div>

<p class="text-muted">Each student here has a linked login account. Administrator and Examination Officer accounts are managed separately from <a asp-controller="User" asp-action="Index">User Management</a>.</p>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-auto flex-grow-1">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name, student number or email..." />
            </div>
            <div class="col-auto" style="min-width:220px;">
                <select name="departmentId" class="form-select" asp-items="@(new SelectList(departmentOptions, "Id", "Name", departmentId))" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student Number</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Program</th>
                    <th>Level</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No students found.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    var initials = string.Concat(item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
                    <tr>
                        <td>@item.StudentNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle avatar-circle-sm">@initials</div>
                                @item.FullName
                            </div>
                        </td>
                        <td>@item.Email</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.ProgramName</td>
                        <td>@item.Level</td>
                        <td>
                            @{
                                var badgeClass = item.Status switch
                                {
                                    StudentStatus.Active => "badge-soft-success",
                                    StudentStatus.Graduated => "badge-soft-primary",
                                    StudentStatus.Suspended => "badge-soft-warning",
                                    _ => "badge-soft-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-delete-name="@item.FullName">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search, departmentId, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
