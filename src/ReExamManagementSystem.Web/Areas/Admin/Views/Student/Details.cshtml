@using ReExamManagementSystem.Domain.Enums
@model StudentDetailsViewModel
@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-person-badge"></i> @Model.FullName</h4>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">Student Profile</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Student Number</dt>
            <dd class="col-sm-9">@Model.StudentNumber</dd>

            <dt class="col-sm-3">Gender</dt>
            <dd class="col-sm-9">@Model.Gender</dd>

            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.PhoneNumber ?? "-")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>

            <dt class="col-sm-3">Program</dt>
            <dd class="col-sm-9">@Model.ProgramName (Level @Model.Level)</dd>

            <dt class="col-sm-3">Academic Year / Semester</dt>
            <dd class="col-sm-9">@Model.AcademicYearName - @Model.SemesterName</dd>

            <dt class="col-sm-3">Enrollment Date</dt>
            <dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @{
                    var badgeClass = Model.Status switch
                    {
                        StudentStatus.Active => "text-bg-success",
                        StudentStatus.Graduated => "text-bg-primary",
                        StudentStatus.Suspended => "text-bg-warning",
                        _ => "text-bg-secondary"
                    };
                }
                <span class="badge @badgeClass">@Model.Status</span>
            </dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">Academic Result History</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Course</th>
                    <th>Academic Year</th>
                    <th>Semester</th>
                    <th>Marks</th>
                    <th>Grade</th>
                    <th>Grade Point</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Results.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No results recorded yet.</td></tr>
                }
                @foreach (var result in Model.Results)
                {
                    <tr>
                        <td>
                            <span class="badge text-bg-secondary">@result.CourseCode</span> @result.CourseName
                        </td>
                        <td>@result.AcademicYearName</td>
                        <td>@result.SemesterName</td>
                        <td>@result.Marks</td>
                        <td>@result.Grade</td>
                        <td>@result.GradePoint</td>
                        <td>
                            @{
                                var resultBadge = result.Status == ResultStatus.Pass ? "text-bg-success" : "text-bg-danger";
                            }
                            <span class="badge @resultBadge">@result.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
