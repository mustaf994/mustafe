@using System.Text.Json
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator Dashboard";

    var cards = new[]
    {
        ("Total Students", Model.TotalStudents, "bi-people-fill", "bg-soft-blue", Url.Action("Index", "Student", new { area = "Admin" })),
        ("Departments", Model.TotalDepartments, "bi-building", "bg-soft-teal", Url.Action("Index", "Department", new { area = "Admin" })),
        ("Programs", Model.TotalPrograms, "bi-mortarboard", "bg-soft-purple", Url.Action("Index", "Program", new { area = "Admin" })),
        ("Courses", Model.TotalCourses, "bi-journal-bookmark", "bg-soft-teal", Url.Action("Index", "Course", new { area = "Admin" })),
        ("Eligible Students", Model.EligibleStudents, "bi-clipboard-check", "bg-soft-yellow", Url.Action("EligibleStudents", "Report", new { area = "" })),
        ("Total Applications", Model.TotalApplications, "bi-file-earmark-text", "bg-soft-blue", Url.Action("Applications", "Report", new { area = "" })),
        ("Upcoming Exams", Model.UpcomingExams, "bi-calendar-event", "bg-soft-blue", Url.Action("Timetable", "Report", new { area = "" })),
        ("Published Results", Model.PublishedResults, "bi-award", "bg-soft-green", Url.Action("Results", "Report", new { area = "", published = true })),
    };
}

<div class="mb-4">
    <h4 class="mb-0">Dashboard</h4>
    <p class="text-muted mb-0">Welcome back, @User.Identity?.Name</p>
</div>

<div class="row g-3 mb-4">
    @foreach (var (title, value, icon, colorClass, url) in cards)
    {
        <div class="col-6 col-md-4 col-xl-3">
            <a href="@url" class="card stat-card stat-card-link h-100 text-decoration-none text-reset">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon @colorClass me-3">
                        <i class="bi @icon"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold">@value</div>
                        <div class="text-muted small">@title</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">Re-Exam Applications by Month</div>
            <div class="card-body">
                <canvas id="applicationsByMonthChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">Students by Department</div>
            <div class="card-body">
                <canvas id="studentsByDepartmentChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">Recent Applications</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentApplications.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No applications yet.</td></tr>
                }
                @foreach (var app in Model.RecentApplications)
                {
                    var pillClass = app.Status switch
                    {
                        "Pending" => "badge-soft-warning",
                        "Approved" => "badge-soft-success",
                        "Rejected" => "badge-soft-danger",
                        "Completed" => "badge-soft-info",
                        _ => "badge-soft-secondary"
                    };
                    <tr>
                        <td>@app.StudentName</td>
                        <td><span class="badge badge-soft-secondary">@app.CourseCode</span></td>
                        <td><span class="badge @pillClass">@app.Status</span></td>
                        <td>@app.ApplicationDate.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script>
        const applicationsByMonth = @Html.Raw(JsonSerializer.Serialize(Model.ApplicationsByMonth));
        const studentsByDepartment = @Html.Raw(JsonSerializer.Serialize(Model.StudentsByDepartment));

        new Chart(document.getElementById('applicationsByMonthChart'), {
            type: 'bar',
            data: {
                labels: applicationsByMonth.map(p => p.Label),
                datasets: [{
                    label: 'Applications',
                    data: applicationsByMonth.map(p => p.Value),
                    backgroundColor: '#0d6efd'
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('studentsByDepartmentChart'), {
            type: 'doughnut',
            data: {
                labels: studentsByDepartment.map(p => p.Label),
                datasets: [{
                    data: studentsByDepartment.map(p => p.Value),
                    backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6f42c1', '#dc3545']
                }]
            },
            options: { responsive: true }
        });
    </script>
}
