@model GradingRuleFormViewModel
@{
    var isEdit = Model.Id != 0;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit Grading Rule" : "Add Grading Rule")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="MinMark" class="form-label"></label>
                <input asp-for="MinMark" type="number" step="0.01" min="0" max="100" class="form-control" autofocus />
                <span asp-validation-for="MinMark" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="MaxMark" class="form-label"></label>
                <input asp-for="MaxMark" type="number" step="0.01" min="0" max="100" class="form-control" />
                <span asp-validation-for="MaxMark" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Grade" class="form-label"></label>
                <input asp-for="Grade" class="form-control" />
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="GradePoint" class="form-label"></label>
                <input asp-for="GradePoint" type="number" step="0.01" min="0" max="5" class="form-control" />
                <span asp-validation-for="GradePoint" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" placeholder="e.g. Excellent" />
        </div>

        <div class="form-check">
            <input asp-for="IsPassing" class="form-check-input" />
            <label asp-for="IsPassing" class="form-check-label"></label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
