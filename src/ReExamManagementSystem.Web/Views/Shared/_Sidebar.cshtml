@* Role-based navigation. Each phase adds its own links here as the matching
   controllers/actions land, so the sidebar never points at a dead route. *@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    Func<string, string?, string> navClass = (controller, action) =>
    {
        var controllerMatches = currentController.Equals(controller, StringComparison.OrdinalIgnoreCase);
        var actionMatches = action is null || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);
        return controllerMatches && actionMatches ? "nav-link active" : "nav-link";
    };
}

<div class="d-flex flex-column flex-shrink-0 p-3 sidebar h-100">
    <a href="/" class="brand d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
