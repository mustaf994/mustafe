@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 text-center mt-5">
        <i class="bi bi-envelope-check text-success" style="font-size: 3rem;"></i>
        <h3 class="mt-3">Check your email</h3>
        <p class="text-muted">
            If an account exists for that email address, we've sent a link to reset your password.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Back to sign in</a>
    </div>
</div>
